# Copy to .env and fill in. .env is gitignored.

# Required: used for answer generation (and by the eval scripts for judging).
ANTHROPIC_API_KEY=

# Optional: if set, /query requires an X-Demo-Key header with this value.
# Leave empty for local use (the demo page does not send a key).
DEMO_API_KEY=

# Optional: per-IP rate limit on /query (defaults: 10 requests / 300 s).
# RATE_LIMIT_MAX_REQUESTS=10
# RATE_LIMIT_WINDOW_SECONDS=300
